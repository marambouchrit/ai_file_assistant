# Copy to .env and fill in. Every value except LLM_API_KEY has a default in app/config.py.

# The LLM is called through an OpenAI-compatible chat API. Default: Google Gemini
# (key from https://aistudio.google.com). For OpenAI, use
# LLM_BASE_URL=https://api.openai.com/v1 and LLM_MODEL=gpt-4o-mini.
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Use 127.0.0.1, not localhost: on Windows localhost adds ~2s per request.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=documents

# Changing the embedding model means re-indexing every document.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# The embedding model only reads the first 128 tokens (~480 chars) of a chunk.
CHUNK_SIZE=450
CHUNK_OVERLAP=60

MAX_UPLOAD_MB=10
