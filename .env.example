# Copy to .env and fill in. Every value except OPENAI_API_KEY has a default in app/config.py.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# Changing the embedding model means re-indexing every document.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# The embedding model only reads the first 128 tokens (~480 chars) of a chunk.
CHUNK_SIZE=450
CHUNK_OVERLAP=60
