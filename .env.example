# Copy to .env and fill in. Every value except OPENAI_API_KEY has a default in app/config.py.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# Changing the embedding model means re-indexing every document.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

CHUNK_SIZE=800
CHUNK_OVERLAP=100
